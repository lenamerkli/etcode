# Copy to .env and fill in. Real environment variables override this file.

# Backend tokens, comma separated. Use "name:token" so that a token can be rotated
# without losing its sessions (sessions belong to the name). A bare "token" is
# identified by its hash, so its sessions are tied to that exact token.
ETCODE_API_TOKENS=desktop:change-me-to-a-long-random-string

ETCODE_HOST=0.0.0.0
ETCODE_PORT=8765
# ETCODE_DATA_DIR=/var/lib/etcode-backend   # default: etcode_backend/data

ARENA_API_KEY=
# ARENA_EXTRA_HEADERS={}
OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_TITLE=etcode

ETCODE_SEARCH_PROVIDER=brave
BRAVE_API_KEY=

# ETCODE_WORKER_CONCURRENCY=8
# ETCODE_GUNICORN_WORKERS=2
# ETCODE_GUNICORN_THREADS=32
