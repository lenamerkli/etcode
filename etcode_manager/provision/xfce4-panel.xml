<?xml version="1.0" encoding="UTF-8"?>

<!-- Xfce panel layout for etcode VMs (SETTINGS.md).
     Extracted from a configured reference VM, taskbar left to right:
       1. app selector   - Whisker Menu (appfinder button icon)
       2. quick launch   - Firefox, Thunar, Terminal, VSCodium (one launcher
                          plugin per app; launcher-*/ hold the item .desktop
                          files the launcher plugin uses)
       -- expanding separator: pushes everything below to the right edge --
       3. window buttons - open windows (like the Windows taskbar)
       4. tray icons     - Notification Area
       5. calendar       - Clock (click opens the calendar)
       6. user           - username with session menu (shutdown, restart, ...)
     Paths: panel settings live at /panels/panel-N, plugin settings at
     /plugins/plugin-N, and the plugin type is the value of /plugins/plugin-N.
     Note: in Xfce 4.20 `length` is a double (percent of the screen edge). -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=12;x=960;y=1040"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="48"/>
      <property name="length" type="double" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="10"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <!-- 1. app selector -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="org.xfce.appfinder"/>
    </property>
    <!-- 2. quick launch (one launcher per app, in order) -->
    <property name="plugin-2" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="17929499121.desktop"/>
      </property>
    </property>
    <property name="plugin-3" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="17929499122.desktop"/>
      </property>
      <property name="show-label" type="bool" value="false"/>
      <property name="move-first" type="bool" value="false"/>
    </property>
    <property name="plugin-4" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="17929499123.desktop"/>
      </property>
    </property>
    <property name="plugin-5" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="17929499124.desktop"/>
      </property>
    </property>
    <!-- expanding separator: right-aligns window buttons, tray, clock, user -->
    <property name="plugin-10" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
      <property name="expand" type="bool" value="true"/>
    </property>
    <!-- 3. window buttons -->
    <property name="plugin-6" type="string" value="tasklist"/>
    <!-- 4. tray icons -->
    <property name="plugin-7" type="string" value="systray"/>
    <!-- 5. calendar (clock; clicking it opens the calendar popup) -->
    <property name="plugin-8" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="show-week-numbers" type="bool" value="true"/>
    </property>
    <!-- 6. user (shows the user name; click opens the session menu) -->
    <property name="plugin-9" type="string" value="actions">
      <property name="appearance" type="uint" value="1"/>
      <property name="ask-confirmation" type="bool" value="true"/>
      <property name="items" type="array">
        <value type="string" value="+lock-screen"/>
        <value type="string" value="+switch-user"/>
        <value type="string" value="+separator"/>
        <value type="string" value="+suspend"/>
        <value type="string" value="-hibernate"/>
        <value type="string" value="+separator"/>
        <value type="string" value="+restart"/>
        <value type="string" value="+shutdown"/>
        <value type="string" value="+separator"/>
        <value type="string" value="+logout"/>
      </property>
    </property>
  </property>
</channel>